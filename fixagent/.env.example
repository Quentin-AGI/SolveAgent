# Anthropic-compatible provider profile. Never commit real credentials.
ANTHROPIC_BASE_URL=
# Configure exactly one credential type for a provider profile.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
FIXAGENT_PROVIDER_ID=
FIXAGENT_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_FABLE_MODEL=
FIXAGENT_EXPECTED_OBSERVED_MODEL_ID=
FIXAGENT_EXPECTED_CLAUDE_CODE_VERSION=
FIXAGENT_PROVIDER_CAPABILITIES=
FIXAGENT_CONTEXT_WINDOW=
FIXAGENT_TOOL_SEARCH_MODE=
FIXAGENT_BILLING_PLAN=
FIXAGENT_PROVIDER_REGION=
FIXAGENT_ENDPOINT_SOURCE=
FIXAGENT_PROFILE_CONFIG_HASH=
FIXAGENT_FALLBACK_DETECTED=false

# Local V0 application settings.
FIXAGENT_HOST=127.0.0.1
FIXAGENT_PORT=4174
FIXAGENT_RUNTIME_ROOT=.runtime/cases
# Optional private multi-model registry path override. The model settings UI
# otherwise writes to .runtime/provider-profiles.json.
FIXAGENT_PROVIDER_PROFILES_FILE=
# Optional reviewed and hash-valid snapshot. Unset uses EMPTY_EUFY_EVAL_V0.
FIXAGENT_KNOWLEDGE_SNAPSHOT_FILE=
# Optional private, hash-valid eufy order/dealer dataset. Keep this outside the
# repository; the Agent cannot read the configured path directly.
FIXAGENT_AFTER_SALES_DATA_FILE=
