{
  "name": "fixagent-v0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node --import tsx scripts/check-architecture.ts",
    "eval:convert:camb": "node --import tsx scripts/convert-camb.ts",
    "eval:convert:visa-pcb": "node --import tsx scripts/convert-visa-pcb.ts",
    "eval:score": "node --import tsx scripts/score-evaluation.ts",
    "eval:run": "node --import tsx scripts/run-evaluation.ts",
    "knowledge:import:raft": "node --import tsx scripts/import-raft-trajectories.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
